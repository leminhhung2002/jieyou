PORT=4000
NODE_ENV=development
# Origin của frontend (dùng cho CORS). Nhiều origin cách nhau bởi dấu phẩy.
CLIENT_ORIGIN=http://localhost:5173
# Bí mật ký JWT – BẮT BUỘC đổi khi chạy production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Thời gian sống của mã OTP (giây)
OTP_TTL_SECONDS=300
# Mật khẩu ban đầu cho tài khoản quản trị mẫu – BẮT BUỘC đổi khi chạy production
ADMIN_DEFAULT_PASSWORD=admin12345

# Địa chỉ website công khai (link + ảnh trong email)
PUBLIC_URL=http://localhost:5173
MAIL_FROM="JIEYOU <agency.jieyou@gmail.com>"
# Địa chỉ lắng nghe (production sau nginx: 127.0.0.1)
# HOST=127.0.0.1

# Gửi email (mã OTP + thông báo) qua Gmail SMTP – BẮT BUỘC khi chạy production
# SMTP_PASS là "Mật khẩu ứng dụng" 16 ký tự (Tài khoản Google › Bảo mật › Xác minh 2 bước › Mật khẩu ứng dụng),
# KHÔNG phải mật khẩu đăng nhập Gmail. Địa chỉ người gửi luôn là SMTP_USER (Gmail bắt buộc như vậy).
SMTP_USER=agency.jieyou@gmail.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# File CSDL SQLite (tương đối so với thư mục server). Bản sao lưu hằng ngày ở <thư mục>/backups
# DB_FILE=storage/jieyou.db

# Tăng tương tác MXH tự động qua API hotrodvfb.com (lấy key ở trang "Website & API" của hotrodvfb).
# Để trống → đơn MXH vẫn do admin duyệt tay như trước.
HOTRODVFB_API_KEY=
# HOTRODVFB_API_URL=https://hotrodvfb.com/api/v2
# Lãi cộng thêm trên giá hotrodvfb (%)
# SMM_MARKUP_PERCENT=30
# Tỉ giá dự phòng nếu hotrodvfb không trả tỉ giá (VND / 1 USD)
# SMM_USD_VND=26000
# Chu kỳ đồng bộ trạng thái đơn (giây, tối thiểu 30)
# SMM_SYNC_SECONDS=120
