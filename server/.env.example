PORT=4000
NODE_ENV=development
# Origin của frontend (dùng cho CORS). Nhiều origin cách nhau bởi dấu phẩy.
CLIENT_ORIGIN=http://localhost:5173
# Bí mật ký JWT – BẮT BUỘC đổi khi chạy production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Thời gian sống của mã OTP (giây)
OTP_TTL_SECONDS=300
# Mật khẩu ban đầu cho tài khoản quản trị mẫu – BẮT BUỘC đổi khi chạy production
ADMIN_DEFAULT_PASSWORD=admin12345

# Địa chỉ website công khai (link + ảnh trong email)
PUBLIC_URL=http://localhost:5173
MAIL_FROM="JIEYOU <no-reply@jieyouagency.com>"
# Địa chỉ lắng nghe (production sau nginx: 127.0.0.1)
# HOST=127.0.0.1
